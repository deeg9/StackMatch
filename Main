    <script>
        // State management
        let currentView = 'home';
        let currentUserType = null;

        // Navigation functions
        function showHome() {
            hideAll();
            document.getElementById('hero').style.display = 'block';
            currentView = 'home';
        }

        function showDashboard(type) {
            hideAll();
            currentUserType = type;
            if (type === 'business') {
                document.getElementById('businessDashboard').style.display = 'block';
            } else {
                document.getElementById('providerDashboard').style.display = 'block';
            }
            currentView = 'dashboard';
        }

        function showCreateListing() {
            hideAll();
            document.getElementById('createListingForm').style.display = 'block';
            currentView = 'createListing';
        }

        function hideAll() {
            document.getElementById('hero').style.display = 'none';
            document.getElementById('businessDashboard').style.display = 'none';
            document.getElementById('providerDashboard').style.display = 'none';
            document.getElementById('createListingForm').style.display = 'none';
        }

        // Tab switching
        function switchTab(tab) {
            const tabs = document.querySelectorAll('#businessDashboard .tab');
            tabs.forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            
            // Here you would load different content based on the tab
            if (tab === 'completed') {
                document.getElementById('businessListings').innerHTML = '<p style="text-align: center; color: #6b7280;">No completed projects yet</p>';
            } else {
                // Reload active listings
                location.reload();
            }
        }

        function switchProviderTab(tab) {
            const tabs = document.querySelectorAll('#providerDashboard .tab');
            tabs.forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            
            if (tab === 'mybids') {
                document.getElementById('providerListings').innerHTML = `
                    <div class="card listing-card">
                        <div class="listing-header">
                            <div class="company-info">
                                <h3>Your Bid: CRM System</h3>
                                <p>Status: Under Review</p>
                            </div>
                            <span class="listing-badge" style="background: #fef3c7; color: #92400e;">Pending</span>
                        </div>
                        <div class="listing-footer">
                            <span class="bid-count">Bid Amount: $65,000</span>
                            <button class="btn btn-secondary">Edit Bid</button>
                        </div>
                    </div>
                `;
            } else {
                location.reload();
            }
        }

        // Form submission
        function submitListing(e) {
            e.preventDefault();
            alert('Listing created successfully! Redirecting to dashboard...');
            showDashboard('business');
        }

        // Modal functions
        function viewBids() {
            document.getElementById('bidsModal').style.display = 'block';
        }

        function closeBidsModal() {
            document.getElementById('bidsModal').style.display = 'none';
        }

        function prepareBid() {
            alert('Bid preparation form would open here. This would include:\n\n1. Detailed quote preparation\n2. Timeline estimation\n3. Team assignment\n4. Service details\n5. Pricing breakdown');
        }

        // Placeholder functions
        function showLogin() {
            alert('Login functionality would be implemented here');
        }

        function showSignup(type) {
            if (type) {
                alert(`Sign up as ${type} would be implemented here`);
            } else {
                alert('Sign up page would be implemented here');
            }
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('bidsModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }
    </script>
</body>
